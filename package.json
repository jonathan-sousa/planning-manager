{
  "name": "planning-manager",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run --passWithNoTests",
    "format": "prettier --write .",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build",
    "solver:test": "uv run --directory solver pytest",
    "infra:synth": "cdk synth --quiet",
    "infra:deploy": "cdk deploy 'PlanningManager-*' --outputs-file cdk-outputs.json",
    "infra:watch": "cdk watch 'PlanningManager-*'",
    "infra:destroy": "cdk destroy 'PlanningManager-*'",
    "env:write": "tsx scripts/write-env.ts",
    "db:generate": "aurora-dsql-drizzle generate --out ./api/db/migrations -- --config drizzle.config.ts",
    "db:migrate": "tsx scripts/db-migrate.ts",
    "db:status": "tsx scripts/db-status.ts",
    "postinfra:deploy": "npm run env:write && npm run db:migrate",
    "infra:size": "tsx scripts/asset-sizes.ts",
    "db:seed": "tsx scripts/db-seed.ts",
    "infra:deploy:mail": "cdk deploy PlanningManagerMail",
    "infra:deploy:prod": "npm run build && cdk deploy -c stage=prod PlanningManager-prod --outputs-file cdk-outputs.prod.json && CDK_OUTPUTS=cdk-outputs.prod.json tsx scripts/db-migrate.ts"
  },
  "dependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.1150.0",
    "@aws-sdk/client-lambda": "^3.1150.0",
    "@aws/aurora-dsql-drizzle": "^0.2.0",
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@hono/aws-lambda": "^1.0.1",
    "@hono/zod-validator": "^0.9.1",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-query": "^5.104.2",
    "@tanstack/react-router": "^1.170.44",
    "aws-amplify": "^6.22.1",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.4.0",
    "drizzle-orm": "^0.45.4",
    "hono": "^4.13.13",
    "lucide-react": "^1.56.0",
    "pg": "^8.23.1",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@aws-cdk/aws-dsql-alpha": "^2.273.0-alpha.0",
    "@tanstack/react-query-devtools": "^5.104.2",
    "@tanstack/react-router-devtools": "^1.167.2",
    "@tanstack/router-plugin": "^1.168.45",
    "@types/aws-lambda": "^8.10.164",
    "@types/node": "^24.19.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "aws-cdk": "^2.1145.0",
    "aws-cdk-lib": "^2.273.0",
    "constructs": "^10.8.1",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "oxlint": "^1.88.0",
    "prettier": "^3.9.10",
    "tsx": "^4.23.15",
    "typescript": "~6.0.3",
    "vite": "^8.3.4",
    "vitest": "^5.0.4"
  },
  "allowScripts": {
    "esbuild": true,
    "fsevents": true
  },
  "overrides": {
    "esbuild": "$esbuild"
  }
}
